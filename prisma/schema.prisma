generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole { PLAYER MODERATOR ADMIN FINANCE_SUPPORT }
enum TransactionType { SALARY BUSINESS_PURCHASE BUSINESS_INCOME STOCK_BUY STOCK_SELL BONUS BANK_INTEREST TRANSFER TAX LOAN_REPAYMENT ADMIN_ADJUSTMENT }
enum AccountType { CHECKING SAVINGS INVESTMENT CERTIFICATE }
enum OrderSide { BUY SELL }
enum OrderType { MARKET LIMIT STOP_LOSS }
enum LoanStatus { ACTIVE PAID DEFAULTED }
enum AssetType { HOUSE APARTMENT VILLA LAND SHOP OFFICE FACTORY WAREHOUSE HOTEL RESORT PALACE }
enum VehicleType { ECONOMY LUXURY SPORTS TRUCK COMPANY }
enum JobContractType { DAILY MONTHLY FREELANCE VIP }
enum ReportStatus { OPEN REVIEWING RESOLVED DISMISSED }

model User {
  id String @id @default(cuid())
  username String @unique
  email String? @unique
  phone String? @unique
  googleId String? @unique
  passwordHash String?
  avatarUrl String?
  avatarFrame String?
  profileBackground String?
  bio String?
  title String?
  level Int @default(1)
  experience Int @default(0)
  reputation Int @default(0)
  creditScore Int @default(600)
  role UserRole @default(PLAYER)
  vipLevel Int @default(0)
  isBanned Boolean @default(false)
  isFrozen Boolean @default(false)
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wallet Wallet?
  sessions Session[]
  bankAccounts BankAccount[]
  transactions Transaction[]
  sentTransfers Transfer[] @relation("Sender")
  receivedTransfers Transfer[] @relation("Receiver")
  holdings StockHolding[]
  orders Order[]
  businesses UserBusiness[]
  companies Company[]
  realEstate RealEstate[]
  vehicles Vehicle[]
  jobs UserJob[]
  jobApplications JobApplication[]
  notifications Notification[]
  activities Activity[]
  loginEvents LoginEvent[]
  friendshipsSent Friendship[] @relation("FriendshipSender")
  friendshipsReceived Friendship[] @relation("FriendshipReceiver")
  reportsMade Report[] @relation("Reporter")
  reportsReceived Report[] @relation("ReportedUser")
  auditLogs AuditLog[]
  ownedAuctions Auction[]
  auctionBids AuctionBid[]
}

model Session { id String @id @default(cuid()); tokenHash String @unique; userId String; expiresAt DateTime; userAgent String?; ipHash String?; createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); @@index([userId, expiresAt]) }
model Wallet { id String @id @default(cuid()); userId String @unique; cash Decimal @default(1200); bankBalance Decimal @default(500); savingsBalance Decimal @default(0); investmentBalance Decimal @default(0); user User @relation(fields:[userId], references:[id], onDelete: Cascade); updatedAt DateTime @updatedAt }
model BankAccount { id String @id @default(cuid()); userId String; name String; type AccountType; balance Decimal @default(0); interestRate Float @default(0.01); withdrawalLimit Decimal @default(10000); user User @relation(fields:[userId], references:[id], onDelete: Cascade); createdAt DateTime @default(now()); @@index([userId, type]) }
model Transaction { id String @id @default(cuid()); userId String; type TransactionType; amount Decimal; balanceBefore Decimal; balanceAfter Decimal; fee Decimal @default(0); reference String?; createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); @@index([userId, createdAt]) }
model Transfer { id String @id @default(cuid()); senderId String; receiverId String; amount Decimal; fee Decimal @default(0); note String?; scheduledAt DateTime?; createdAt DateTime @default(now()); sender User @relation("Sender", fields:[senderId], references:[id], onDelete: Cascade); receiver User @relation("Receiver", fields:[receiverId], references:[id], onDelete: Cascade) }
model Loan { id String @id @default(cuid()); userId String; principal Decimal; remaining Decimal; interestRate Float; installment Decimal; dueAt DateTime; status LoanStatus @default(ACTIVE); user User @relation(fields:[userId], references:[id], onDelete: Cascade) }
model Job { id String @id @default(cuid()); name String; requiredLevel Int; salary Decimal; xpReward Int; contractType JobContractType @default(MONTHLY); applications JobApplication[]; userJobs UserJob[] }
model UserJob { id String @id @default(cuid()); userId String; jobId String; assignedAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); job Job @relation(fields:[jobId], references:[id], onDelete: Cascade); @@unique([userId, jobId]) }
model JobApplication { id String @id @default(cuid()); userId String; jobId String; status String @default("PENDING"); user User @relation(fields:[userId], references:[id], onDelete: Cascade); job Job @relation(fields:[jobId], references:[id], onDelete: Cascade) }
model Business { id String @id @default(cuid()); name String; description String; basePrice Decimal; baseIncome Decimal; upgradeMultiplier Float @default(1.2); userBusinesses UserBusiness[] }
model UserBusiness { id String @id @default(cuid()); userId String; businessId String; quantity Int @default(0); level Int @default(1); lastIncomeAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); business Business @relation(fields:[businessId], references:[id], onDelete: Cascade); @@unique([userId, businessId]) }
model Company { id String @id @default(cuid()); ownerId String; name String @unique; logoUrl String?; sector String; country String?; city String?; capital Decimal @default(0); value Decimal @default(0); reputation Int @default(0); owner User @relation(fields:[ownerId], references:[id], onDelete: Cascade); employees CompanyEmployee[]; branches CompanyBranch[]; inventory CompanyInventory[]; shares Stock[]; createdAt DateTime @default(now()) }
model CompanyEmployee { id String @id @default(cuid()); companyId String; name String; role String; salary Decimal; rating Int @default(50); company Company @relation(fields:[companyId], references:[id], onDelete: Cascade) }
model CompanyBranch { id String @id @default(cuid()); companyId String; name String; location String; company Company @relation(fields:[companyId], references:[id], onDelete: Cascade) }
model CompanyInventory { id String @id @default(cuid()); companyId String; item String; quantity Int @default(0); unitCost Decimal @default(0); company Company @relation(fields:[companyId], references:[id], onDelete: Cascade) }
model Stock { id String @id @default(cuid()); symbol String @unique; name String; price Decimal; volatility Float @default(0.05); companyId String?; company Company? @relation(fields:[companyId], references:[id], onDelete: SetNull); holdings StockHolding[]; orders Order[]; updatedAt DateTime @updatedAt }
model StockHolding { id String @id @default(cuid()); userId String; stockId String; quantity Int @default(0); averagePrice Decimal; user User @relation(fields:[userId], references:[id], onDelete: Cascade); stock Stock @relation(fields:[stockId], references:[id], onDelete: Cascade); @@unique([userId, stockId]) }
model Order { id String @id @default(cuid()); userId String; stockId String; side OrderSide; type OrderType; quantity Int; limitPrice Decimal?; stopPrice Decimal?; filled Int @default(0); status String @default("OPEN"); user User @relation(fields:[userId], references:[id], onDelete: Cascade); stock Stock @relation(fields:[stockId], references:[id], onDelete: Cascade); createdAt DateTime @default(now()); @@index([stockId, status]) }
model RealEstate { id String @id @default(cuid()); ownerId String; type AssetType; name String; region String; price Decimal; rent Decimal @default(0); maintenance Decimal @default(0); level Int @default(1); owner User @relation(fields:[ownerId], references:[id], onDelete: Cascade) }
model Vehicle { id String @id @default(cuid()); ownerId String; type VehicleType; name String; price Decimal; maintenance Decimal @default(0); insurance Decimal @default(0); condition Int @default(100); owner User @relation(fields:[ownerId], references:[id], onDelete: Cascade) }
model Friendship { id String @id @default(cuid()); senderId String; receiverId String; status String @default("PENDING"); sender User @relation("FriendshipSender", fields:[senderId], references:[id], onDelete: Cascade); receiver User @relation("FriendshipReceiver", fields:[receiverId], references:[id], onDelete: Cascade); @@unique([senderId, receiverId]) }
model Activity { id String @id @default(cuid()); userId String; type String; message String; ipHash String?; createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); @@index([userId, createdAt]) }
model LoginEvent { id String @id @default(cuid()); userId String; userAgent String?; ipHash String?; success Boolean; createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); @@index([userId, createdAt]) }
model Notification { id String @id @default(cuid()); userId String; title String; message String; isRead Boolean @default(false); createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade) }
model Report { id String @id @default(cuid()); reporterId String; reportedUserId String?; reason String; status ReportStatus @default(OPEN); resolution String?; createdAt DateTime @default(now()); reporter User @relation("Reporter", fields:[reporterId], references:[id], onDelete: Cascade); reportedUser User? @relation("ReportedUser", fields:[reportedUserId], references:[id], onDelete: SetNull) }
model AuditLog { id String @id @default(cuid()); actorId String?; action String; target String?; metadata String?; createdAt DateTime @default(now()); actor User? @relation(fields:[actorId], references:[id], onDelete: SetNull); @@index([createdAt]) }
model Auction { id String @id @default(cuid()); sellerId String; title String; currentPrice Decimal; endsAt DateTime; status String @default("OPEN"); seller User @relation(fields:[sellerId], references:[id], onDelete: Cascade); bids AuctionBid[] }
model AuctionBid { id String @id @default(cuid()); auctionId String; bidderId String; amount Decimal; auction Auction @relation(fields:[auctionId], references:[id], onDelete: Cascade); bidder User @relation(fields:[bidderId], references:[id], onDelete: Cascade) }
