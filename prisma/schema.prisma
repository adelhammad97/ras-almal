generator client {
  provider = "prisma-client-js"
}

datasource db { provider = "sqlite"; url = env("DATABASE_URL") }
enum UserRole { PLAYER MODERATOR ADMIN }
enum TransactionType { SALARY BUSINESS_PURCHASE BUSINESS_INCOME STOCK_BUY STOCK_SELL BONUS BANK_INTEREST TRANSFER TAX LOAN_REPAYMENT ADMIN_ADJUSTMENT }
enum AccountType { CHECKING SAVINGS INVESTMENT CERTIFICATE }
enum OrderSide { BUY SELL }
enum OrderType { MARKET LIMIT }
enum LoanStatus { ACTIVE PAID DEFAULTED }
enum ReportStatus { OPEN REVIEWING RESOLVED DISMISSED }
enum AuctionStatus { OPEN SOLD CANCELLED }
enum AssetType { HOUSE APARTMENT VILLA LAND SHOP OFFICE FACTORY }
enum VehicleType { ECONOMY LUXURY SPORTS TRUCK COMPANY }
enum JobContractType { DAILY MONTHLY FREELANCE VIP }

model User { id String @id @default(cuid()); username String @unique; email String? @unique; phone String? @unique; googleId String? @unique; passwordHash String?; avatarUrl String?; avatarFrame String?; bio String?; title String?; level Int @default(1); experience Int @default(0); creditScore Int @default(600); role UserRole @default(PLAYER); isBanned Boolean @default(false); lastSeenAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; wallet Wallet?; sessions Session[]; transactions Transaction[]; bankAccounts BankAccount[]; transfersSent Transfer[] @relation("Sender"); transfersReceived Transfer[] @relation("Receiver"); loans Loan[]; companies Company[]; realEstate RealEstate[]; vehicles Vehicle[]; jobs UserJob[]; jobApplications JobApplication[]; orders Order[]; holdings StockHolding[]; notifications Notification[] }
model Session { id String @id @default(cuid()); tokenHash String @unique; userId String; expiresAt DateTime; createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); @@index([userId, expiresAt]) }
model Wallet { id String @id @default(cuid()); userId String @unique; cash Decimal @default(1200); bankBalance Decimal @default(500); user User @relation(fields:[userId], references:[id], onDelete: Cascade) }
model Transaction { id String @id @default(cuid()); userId String; type TransactionType; amount Decimal; balanceBefore Decimal; balanceAfter Decimal; reference String?; createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); @@index([userId, createdAt]) }
model Transfer { id String @id @default(cuid()); senderId String; receiverId String; amount Decimal; fee Decimal @default(0); note String?; createdAt DateTime @default(now()); sender User @relation("Sender", fields:[senderId], references:[id], onDelete: Cascade); receiver User @relation("Receiver", fields:[receiverId], references:[id], onDelete: Cascade) }
model BankAccount { id String @id @default(cuid()); userId String; name String; type AccountType; balance Decimal @default(0); interestRate Float @default(0.01); withdrawalLimit Decimal @default(10000); user User @relation(fields:[userId], references:[id], onDelete: Cascade); cards BankCard[]; createdAt DateTime @default(now()) }
model BankCard { id String @id @default(cuid()); accountId String; lastFour String; active Boolean @default(true); dailyLimit Decimal @default(1000); account BankAccount @relation(fields:[accountId], references:[id], onDelete: Cascade) }
model Loan { id String @id @default(cuid()); userId String; principal Decimal; remaining Decimal; interestRate Float; installment Decimal; dueAt DateTime; status LoanStatus @default(ACTIVE); user User @relation(fields:[userId], references:[id], onDelete: Cascade) }
model Job { id String @id @default(cuid()); name String; requiredLevel Int; salary Decimal; xpReward Int; contractType JobContractType; applications JobApplication[]; userJobs UserJob[] }
model UserJob { id String @id @default(cuid()); userId String; jobId String; assignedAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); job Job @relation(fields:[jobId], references:[id], onDelete: Cascade); @@unique([userId, jobId]) }
model JobApplication { id String @id @default(cuid()); userId String; jobId String; status String @default("PENDING"); user User @relation(fields:[userId], references:[id], onDelete: Cascade); job Job @relation(fields:[jobId], references:[id], onDelete: Cascade) }
model Business { id String @id @default(cuid()); name String; description String; basePrice Decimal; baseIncome Decimal; userBusinesses UserBusiness[] }
model UserBusiness { id String @id @default(cuid()); userId String; businessId String; quantity Int @default(0); level Int @default(1); user User @relation(fields:[userId], references:[id], onDelete: Cascade); business Business @relation(fields:[businessId], references:[id], onDelete: Cascade); @@unique([userId, businessId]) }
model Company { id String @id @default(cuid()); ownerId String; name String @unique; logoUrl String?; sector String; capital Decimal @default(0); owner User @relation(fields:[ownerId], references:[id], onDelete: Cascade); employees CompanyEmployee[]; branches CompanyBranch[]; inventory CompanyInventory[]; shares Stock[] }
model CompanyEmployee { id String @id @default(cuid()); companyId String; name String; role String; salary Decimal; company Company @relation(fields:[companyId], references:[id], onDelete: Cascade) }
model CompanyBranch { id String @id @default(cuid()); companyId String; name String; location String; company Company @relation(fields:[companyId], references:[id], onDelete: Cascade) }
model CompanyInventory { id String @id @default(cuid()); companyId String; item String; quantity Int @default(0); unitCost Decimal @default(0); company Company @relation(fields:[companyId], references:[id], onDelete: Cascade) }
model Stock { id String @id @default(cuid()); symbol String @unique; name String; price Decimal; volatility Float @default(0.05); companyId String?; company Company? @relation(fields:[companyId], references:[id], onDelete: SetNull); holdings StockHolding[]; orders Order[] }
model StockHolding { id String @id @default(cuid()); userId String; stockId String; quantity Int @default(0); averagePrice Decimal; user User @relation(fields:[userId], references:[id], onDelete: Cascade); stock Stock @relation(fields:[stockId], references:[id], onDelete: Cascade); @@unique([userId, stockId]) }
model Order { id String @id @default(cuid()); userId String; stockId String; side OrderSide; type OrderType; quantity Int; limitPrice Decimal?; filled Int @default(0); status String @default("OPEN"); user User @relation(fields:[userId], references:[id], onDelete: Cascade); stock Stock @relation(fields:[stockId], references:[id], onDelete: Cascade); createdAt DateTime @default(now()) }
model RealEstate { id String @id @default(cuid()); ownerId String; type AssetType; name String; region String; price Decimal; rent Decimal @default(0); maintenance Decimal @default(0); level Int @default(1); owner User @relation(fields:[ownerId], references:[id], onDelete: Cascade) }
model Vehicle { id String @id @default(cuid()); ownerId String; type VehicleType; name String; price Decimal; maintenance Decimal @default(0); insurance Decimal @default(0); condition Int @default(100); owner User @relation(fields:[ownerId], references:[id], onDelete: Cascade) }
model Notification { id String @id @default(cuid()); userId String; title String; message String; isRead Boolean @default(false); createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade) }
